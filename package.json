{
  "name": "healthy-smile-care-dental-clinic",
  "private": true,
  "version": "0.1.0",
  "description": "Digital calling card and appointment booking site for Healthy Smile Care Dental Clinic",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "card": "node tools/calling-card/build.cjs",
    "card:bleed": "BLEED_PX=12 node tools/calling-card/build.cjs"
  },
  "dependencies": {
    "@fontsource-variable/dancing-script": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "qrcode": "^1.5.4",
    "typescript": "~5.9.3",
    "vite": "^8.3.5"
  }
}
